TMDB_API_KEY=your_tmdb_api_key
# Optional: JSON array for multi-key rotation
# TMDB_API_KEYS=["key1","key2"]
# Optional: server port (defaults to 8787)
# API_PORT=8787

# ---------------------------------------------------------------------------
# Hosting / public URL
# ---------------------------------------------------------------------------
# The interface to bind. Defaults to 0.0.0.0 (all interfaces). Set to 127.0.0.1
# to expose only to this machine. Ignored on serverless platforms.
# BIND_HOST=0.0.0.0

# The public origin every returned stream URL is built from. Leave unset to
# derive it per request from the Host / X-Forwarded-* headers, which is correct
# behind a reverse proxy, a tunnel (ngrok / Cloudflare) or a platform edge
# (Vercel / Fly / Railway / Render). Set it to pin a custom domain, and include
# a path if the API is mounted under one.
# PUBLIC_BASE_URL=https://streams.example.com

# How many reverse-proxy hops to trust for the client IP and request protocol.
# Defaults to 1 (a single edge). Use a number, true/false, or an Express value
# such as "loopback". The public-URL resolution above does not depend on this.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Auth (needed on read-only filesystems such as serverless, where
# utils/auth-users.json cannot be written)
# ---------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# Or provide pre-hashed users: AUTH_USERS=[{"username":"admin","hash":"salt:derived"}]
