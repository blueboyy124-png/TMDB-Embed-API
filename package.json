{
  "name": "tmdb-embed-api",
  "version": "1.3.0",
  "description": "Standalone streaming embed source aggregation API (TMDB ID in, streams out)",
  "main": "apiServer.js",
  "scripts": {
    "start": "nodemon --watch restart.trigger apiServer.js",
    "start:dev": "nodemon --watch restart.trigger --ignore providers/.cache --ignore **/cache apiServer.js",
    "lint": "eslint . --ext .js",
    "verify:numbering": "node scripts/verify-numbering.mjs",
    "verify:streams": "node scripts/verify-streams.mjs",
    "verify:classify": "node scripts/verify-classify.mjs",
    "verify:cache": "node scripts/verify-bounded-cache.mjs",
    "verify:backoff": "node scripts/verify-tmdb-backoff.mjs",
    "verify:concurrency": "node scripts/verify-concurrency.mjs",
    "verify:earlyexit": "node scripts/verify-earlyexit.mjs",
    "verify:streammeta": "node scripts/verify-stream-meta.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:coverage": "node scripts/verify-coverage.mjs",
    "verify:linkhealth": "node scripts/verify-link-health.mjs",
    "build:roku": "node scripts/build-roku.mjs",
    "macapp:build": "cd macapp && swift build",
    "macapp:run": "cd macapp && swift run",
    "verify:player": "node scripts/verify-test-player.mjs",
    "verify:playerui": "node scripts/verify-test-player-ui.mjs",
    "verify:load": "node scripts/verify-load.mjs",
    "verify:lag": "node scripts/verify-lag.mjs",
    "verify:unit": "npm run verify:numbering && npm run verify:classify && npm run verify:cache && npm run verify:backoff && npm run verify:concurrency && npm run verify:earlyexit && npm run verify:linkhealth && npm run verify:streammeta",
    "verify": "npm run verify:unit && npm run verify:security && npm run verify:streams && npm run verify:player && npm run verify:playerui",
    "verify:all": "npm run verify && npm run verify:load"
  },
  "dependencies": {
    "aromanize": "^0.1.5",
    "axios": "^1.9.0",
    "axios-cookiejar-support": "^7.0.0",
    "body-parser": "^2.2.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "form-data": "^4.0.3",
    "hls-parser": "^0.13.5",
    "jsdom": "^26.1.0",
    "node-fetch": "^2.7.0",
    "p-limit": "^6.2.0",
    "string-similarity": "^4.0.4",
    "tough-cookie": "^5.1.2",
    "ttl-cache": "^1.0.2",
    "yargs": "^17.7.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.10"
  }
}
